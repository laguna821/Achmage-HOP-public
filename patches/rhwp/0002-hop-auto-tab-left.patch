+impl ResolvedParaStyle {
+    /// 내어쓰기용 자동 탭 — 첫 줄 시작에서 내어쓰기 자리까지의 폭 (px).
+    ///
+    /// [HOP patch 0002] 한/글은 `autoTabLeft` 가 켜진 내어쓰기 문단(indent < 0)의 첫 줄에
+    /// 둘째 줄이 시작하는 자리(왼쪽 여백 + |indent|)에 왼쪽 탭 정지를 하나 더 둔다.
+    /// `가.\t본문` 처럼 머리 기호 뒤 탭이 기본 탭 간격이 아니라 그 자리로 가서 본문 첫 줄이
+    /// 둘째 줄과 같은 x 에서 시작한다 (한글 2024 인쇄 결과와 비교). 자리가 이미 지났으면 효과가 없다.
+    pub fn auto_tab_left_hang(&self) -> Option<f64> {
+        (self.auto_tab_left && self.indent < 0.0).then_some(-self.indent)
+    }
+}
