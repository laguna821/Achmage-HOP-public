+    /// [HOP patch 0012] A document without its own version.xml names the program that wrote it, not Hancom
+    /// Office; the OWPML attributes that layout depends on (`xmlVersion` above) stay as they were.
+    #[test]
+    fn version_xml_names_the_writing_program() {
+        assert!(static_assets::VERSION_XML.contains(r#"application="Achmage HOP""#));
+        assert!(!static_assets::VERSION_XML.contains("Hancom"));
+    }
