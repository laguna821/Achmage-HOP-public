+/// [HOP patch] Whether a package's plain (switch-less) paragraph margins are physical HWPUNIT. A package without
+/// version.xml (Kordoc-based and other generators) is: Hancom 2024 prints such a margin at its face value
+/// (in a Hancom 2024 printout: left 2000 → 20 pt, prev 1760 → 17.6 pt; rhwp drew 10 pt and 8.8 pt), and the HWPX
+/// serializer already writes a package without version.xml that way (`is_none_or` in serializer/hwpx/header.rs).
+pub(crate) fn plain_para_margin_units_physical(version_xml: Option<&[u8]>) -> bool {
+    match version_xml {
+        None => true,
+        Some(bytes) => std::str::from_utf8(bytes).is_ok_and(physical_para_margin_units_from_version),
+    }
+}
