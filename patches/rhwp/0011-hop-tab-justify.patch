+/// [HOP patch 0011] 한글 2024의 탭이 든 양쪽 정렬 줄 [한글 2024 인쇄 결과와 비교]:
+/// 여분은 줄 안 마지막 탭 뒤 공백에만 나누고 탭 앞 공백은 자연 폭이다. 기본 탭 폭이 0인 구역에서는
+/// 줄 끝의 공백·탭을 모두 오른쪽 여백 밖에 매단다. 위치는 줄의 그려지는 텍스트 기준이다.
+#[derive(Clone, Copy, Debug, PartialEq)]
+struct HopTabJustify {
+    /// 여분을 받는 첫 글자 위치(마지막 줄 안 탭 다음, 없으면 0)
+    from: usize,
+    eligible_spaces: usize,
+    /// 매다는 말미 글자 수(공백·탭)와 그 가운데 공백 수
+    trailing_len: usize,
+    trailing_spaces: usize,
+}
+
+fn hop_tab_justify(
+    chars: &[char],
+    trailing_space_limit: usize,
+    zero_width_tabs: bool,
+) -> Option<HopTabJustify> {
+    let trailing_len = chars
+        .iter()
+        .rev()
+        .take_while(|c| **c == ' ' || (zero_width_tabs && **c == '\t'))
+        .count()
+        .min(trailing_space_limit);
+    let (visible, trailing) = chars.split_at(chars.len() - trailing_len);
+    let last_tab = visible.iter().rposition(|c| *c == '\t');
+    if last_tab.is_none() && !trailing.contains(&'\t') {
+        return None;
+    }
+    let from = last_tab.map_or(0, |tab| tab + 1);
+    let eligible_spaces = visible[from..].iter().filter(|c| **c == ' ').count();
+    (eligible_spaces > 0).then(|| HopTabJustify {
+        from,
+        eligible_spaces,
+        trailing_len,
+        trailing_spaces: trailing.iter().filter(|c| **c == ' ').count(),
+    })
+}
