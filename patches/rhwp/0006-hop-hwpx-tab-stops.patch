+/// [HOP patch] Default tab interval standing for "no default tab stops" (HWPX without `tabStopVal`).
+pub(crate) const HOP_NO_DEFAULT_TAB_PX: f64 = 1.0e-6;
+
 /// Resolve styles with the document's format-specific style normalization.
