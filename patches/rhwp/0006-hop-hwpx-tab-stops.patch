     styles.hft_ascii_halfwidth |= document.provenance.hft_ascii_halfwidth_witnessed;
+    // [HOP patch] HWPX: the default tab interval is the section's tabStopVal, and none means no default stops.
+    // A vanishing interval makes every `((x / w).floor() + 1) * w` tab computation return x, i.e. a tab with
+    // no width, without changing them; explicit TabDef stops are still found first.
+    if let Some(val) = document.sections.first().and_then(|s| s.section_def.hop_tab_stop_val) {
+        let width = if val == 0 {
+            HOP_NO_DEFAULT_TAB_PX
+        } else {
+            hwpunit_to_px(val as i32, dpi)
+        };
+        for style in &mut styles.para_styles {
+            style.default_tab_width = width;
+        }
+    }
     if profile.hwpx_stored_layout() {
