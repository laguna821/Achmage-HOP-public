+    // (`find_next_tab_stop` 호출부: 폭 추정·글자 위치·리더·교차 run 탭)가 같은 정지를 본다.
+    // 같은 자리에 사용자 탭이 있으면 그 탭을 쓴다.
+    if let Some(hang) = style.auto_tab_left_hang() {
+        let position = style.margin_left + hang;
+        let at = style
+            .tab_stops
+            .partition_point(|t| t.position < position - 0.5);
+        if style
+            .tab_stops
+            .get(at)
+            .is_none_or(|t| t.position > position + 0.5)
+        {
+            style.tab_stops.insert(
+                at,
+                TabStop {
+                    position,
+                    tab_type: 0,
+                    fill_type: 0,
+                },
+            );
+        }
     }
