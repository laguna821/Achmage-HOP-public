+/// [HOP patch] Hancom 2024 lays out every HWPX tab from the paragraph's TabDef and the section's default
+/// interval: `width` 0/1200/2400 or none print alike, and an explicit stop wins over the stored width (compared on
+/// Hancom 2024 printouts). The stored width/leader/type are a layout cache (generators write constants), so the
+/// tab is read as the placeholder layout recomputes — the #7170 convention, which keeps later tabs on their
+/// ordinals. Saving writes the no-data marker, which Hancom lays out the same way.
+fn parse_tab_extension(_e: &quick_xml::events::BytesStart) -> [u16; 7] {
+    crate::model::paragraph::TAB_EXT_PLACEHOLDER
 }
 
