+/// The flow below an empty-anchor TopAndBottom table in a paragraph without stored lines, before the next
+/// paragraph's own spacing: Hancom 2024 collapses the table's outer bottom margin with that spacing and keeps the
+/// larger one (Hancom 2024 printouts of test documents: 1280 HU margin before a 0-spacing paragraph
+/// gives the whole 12.8 pt; after an 80-row table the same margin before an 8.8 pt heading gives 12.8 pt, not 21.6 pt).
+/// `None` when the rule does not apply (other tables keep rhwp's own flow).
+pub(crate) fn empty_anchor_table_outer_bottom_px(
+    para: Option<&Paragraph>,
+    next: Option<&Paragraph>,
+    table: &crate::model::table::Table,
+    styles: &ResolvedStyleSet,
+    dpi: f64,
+) -> Option<f64> {
+    para.filter(|para| {
+        !table.common.treat_as_char
+            && crate::renderer::float_placement::is_para_topbottom_float(&table.common)
+            && !crate::renderer::typeset::para_has_non_whitespace_text(para)
+            && crate::renderer::para_has_no_stored_line_segs(para)
+    })
+    .map(|_| {
+        let next_spacing_before = next
+            .and_then(|next| styles.para_styles.get(next.para_shape_id as usize))
+            .map_or(0.0, |style| style.spacing_before);
+        (crate::renderer::hwpunit_to_px(table.outer_margin_bottom as i32, dpi) - next_spacing_before).max(0.0)
+    })
+}
