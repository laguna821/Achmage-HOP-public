diff --git a/src/renderer/typeset/paragraph/hop_rules.rs b/src/renderer/typeset/paragraph/hop_rules.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ef8956e2829d7c873390bc25b2b666246361a0ac
--- /dev/null
+++ b/src/renderer/typeset/paragraph/hop_rules.rs
@@ -0,0 +1,149 @@
+//! [HOP patch] Hancom 2024 widow/orphan and keep-with-next pagination.
+//!
+//! Observed in Hancom 2024 printouts of the author's own test documents, one setting at a time (a page holds 39
+//! lines): widowOrphan moves the last line's predecessor along (40 lines: 38+2, not 39+1) and moves a paragraph
+//! whose first line alone would end a page (38+6 lines: 38+6, not 39+5); keepWithNext moves a paragraph whose
+//! successor's first line would not follow it on the page (37/2/1 lines: 37+3, not 39+1).
+//!
+//! The rules apply only where rhwp lays the whole section out itself: stored line segments already carry
+//! Hancom's pagination, and a partly stored section would mix both. Multi-column flow is left alone.
+
+use super::metrics::FormattedParagraph;
+use crate::model::paragraph::Paragraph;
+use crate::renderer::style_resolver::ResolvedStyleSet;
+use crate::renderer::typeset::TypesetState;
+
+/// Longest keep-with-next chain followed (headings stacked on headings).
+const KEEP_WITH_NEXT_CHAIN_LIMIT: usize = 8;
+
+/// Whether the rules apply to this section at the current flow position.
+pub(in crate::renderer::typeset) fn apply(st: &TypesetState, paragraphs: &[Paragraph]) -> bool {
+    st.profile.hop_pagination_rules()
+        && st.col_count == 1
+        && paragraphs
+            .iter()
+            .all(crate::renderer::para_has_no_stored_line_segs)
+}
+
+/// The fit margin against typeset/layout drift (`fit::layout_drift_safety_px`). In a section rhwp lays out itself
+/// both read the same composed line heights, and the margin only cost lines Hancom 2024 fits: a mixed-size
+/// paragraph whose 39th line ends within 3 pt of the body bottom went to the next page (Hancom 2024 printout).
+pub(in crate::renderer::typeset) fn layout_drift_safety_px(st: &TypesetState, paragraphs: &[Paragraph]) -> f64 {
+    if apply(st, paragraphs) {
+        0.0
+    } else {
+        super::fit::layout_drift_safety_px(paragraphs)
+    }
+}
+
+/// Widow control for one page's fragment `cursor_line..end_line` of a paragraph that continues: when only its
+/// last line would go on, one more line goes with it.
+pub(in crate::renderer::typeset) fn widow_end_line(
+    cursor_line: usize,
+    end_line: usize,
+    line_count: usize,
+) -> usize {
+    if end_line < line_count && line_count - end_line == 1 && end_line - cursor_line >= 2 {
+        end_line - 1
+    } else {
+        end_line
+    }
+}
+
+/// Orphan control: the paragraph's first line alone would end this page.
+pub(in crate::renderer::typeset) fn orphan_moves_paragraph(
+    cursor_line: usize,
+    end_line: usize,
+    line_count: usize,
+) -> bool {
+    cursor_line == 0 && end_line == 1 && line_count > 1
+}
+
+/// The paragraph directly follows the last fragment of a table that continued from an earlier page. Hancom 2024
+/// skips the first-line check there: after an 80-row table a 2-line paragraph splits 1+1 and a 3-line one 1+2,
+/// while after a short table or plain text the same paragraphs move whole (Hancom 2024 printouts).
+pub(in crate::renderer::typeset) fn follows_continued_table(
+    current_items: &[crate::renderer::pagination::PageItem],
+) -> bool {
+    matches!(
+        current_items.last(),
+        Some(crate::renderer::pagination::PageItem::PartialTable {
+            is_continuation: true,
+            ..
+        })
+    )
+}
+
+/// Keep with next: this paragraph fits on the page, but the first line of the paragraph it keeps with (after any
+/// further keep-with-next paragraphs) does not, while the whole chain would fit on an empty page.
+/// `format_next` formats a following paragraph by index.
+pub(in crate::renderer::typeset) fn keep_with_next_moves_paragraph(
+    st: &TypesetState,
+    para_idx: usize,
+    fmt: &FormattedParagraph,
+    paragraphs: &[Paragraph],
+    styles: &ResolvedStyleSet,
+    available: f64,
+    page_body: f64,
+    mut format_next: impl FnMut(usize) -> FormattedParagraph,
+) -> bool {
+    let keeps = |idx: usize| {
+        paragraphs
+            .get(idx)
+            .and_then(|p| styles.para_styles.get(p.para_shape_id as usize))
+            .is_some_and(|style| style.keep_with_next)
+    };
+    if st.current_items.is_empty() || !keeps(para_idx) || fmt.total_height > available {
+        return false;
+    }
+    let mut need = fmt.total_height;
+    let mut idx = para_idx + 1;
+    loop {
+        let Some(next) = paragraphs.get(idx) else {
+            return false;
+        };
+        // Objects (tables, pictures) have their own placement rules; follow text paragraphs only.
+        if !next.controls.is_empty() {
+            return false;
+        }
+        let next_fmt = format_next(idx);
+        if keeps(idx) && idx - para_idx < KEEP_WITH_NEXT_CHAIN_LIMIT {
+            need += next_fmt.total_height;
+            idx += 1;
+            continue;
+        }
+        let Some(first_line) = next_fmt.line_heights.first() else {
+            return false;
+        };
+        need += next_fmt.spacing_before + first_line;
+        return need > available && need <= page_body;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn widow_keeps_two_lines_together() {
+        // 40 lines, 39 fit: 38 + 2.
+        assert_eq!(widow_end_line(0, 39, 40), 38);
+        // 79 lines from line 39, 39 fit: 38 + 2.
+        assert_eq!(widow_end_line(39, 78, 79), 77);
+        // Two or more lines go on anyway.
+        assert_eq!(widow_end_line(0, 38, 40), 38);
+        // A fragment of one line cannot give one away.
+        assert_eq!(widow_end_line(5, 6, 7), 6);
+        // The last fragment is not a split.
+        assert_eq!(widow_end_line(0, 40, 40), 40);
+    }
+
+    #[test]
+    fn orphan_moves_a_first_line_alone() {
+        // 6-line paragraph with room for one line (after 38 lines).
+        assert!(orphan_moves_paragraph(0, 1, 6));
+        assert!(!orphan_moves_paragraph(0, 2, 6));
+        assert!(!orphan_moves_paragraph(3, 4, 6));
+        assert!(!orphan_moves_paragraph(0, 1, 1));
+    }
+}
