+    /// [HOP patch] An HWPX section's tabStopVal is the default tab interval; without one a tab takes no width
+    /// unless an explicit stop lies ahead. Other documents keep rhwp's 4000 HWPUNIT.
+    #[test]
+    fn hop_hwpx_tab_stop_val_sets_default_tab_interval() {
+        let interval = |val: Option<u32>| {
+            let mut doc = Document::default();
+            doc.doc_info = make_doc_info_with_font();
+            doc.doc_info.para_shapes.push(Default::default());
+            let mut section = crate::model::document::Section::default();
+            section.section_def.hop_tab_stop_val = val;
+            doc.sections.push(section);
+            let styles = resolve_styles_for_document(&doc, DEFAULT_DPI);
+            assert!(!styles.para_styles.is_empty());
+            styles.para_styles[0].default_tab_width
+        };
+        assert_eq!(interval(Some(6000)), hwpunit_to_px(6000, DEFAULT_DPI));
+        assert_eq!(interval(None), hwpunit_to_px(4000, DEFAULT_DPI));
+        let none = interval(Some(0));
+        let (next, _, _) = crate::renderer::layout::find_next_tab_stop(75.3, &[], none, false, 600.0);
+        assert!((next - 75.3).abs() < 1e-5, "{next}");
+        let stop = [TabStop { position: 160.0, tab_type: 0, fill_type: 0 }];
+        let (next, _, _) = crate::renderer::layout::find_next_tab_stop(75.3, &stop, none, false, 600.0);
+        assert_eq!(next, 160.0);
+    }
+
